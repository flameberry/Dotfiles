# Start tmux session index from 1
set -g base-index 1
setw -g pane-base-index 1

# Set the default terminal to support 256 colors and true color
# set -g default-terminal "screen-256color"
# set -ga terminal-overrides ",xterm-256color:RGB"
# set default-terminal colors to display default terminal colors
set -g default-terminal "xterm-256color"
# set-option -ga terminal-overrides ',xterm-256color:Tc
# Proper colors
set-option -sa terminal-features ',xterm-256color:RGB'
# Undercurl
set-option -g default-terminal "tmux-256color"
set-option -ga terminal-features ",xterm-256color:usstyle"

# Enable mouse support for easier navigation
set -g mouse on

# Set prefix to Ctrl-a for easier access
unbind C-b
set-option -g prefix C-a
bind-key C-a send-prefix

# Reload config file with Prefix + r
bind r source-file ~/.config/tmux/tmux.conf \; display "✨ Config reloaded! ✨"

# Pane switching with Alt + arrow keys without prefix
bind -n M-Left select-pane -L
bind -n M-Right select-pane -R
bind -n M-Up select-pane -U
bind -n M-Down select-pane -D

# Split panes with | and -
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
unbind '"'
unbind %

# Initialize Tmux Plugin Manager
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'rose-pine/tmux'

# Rosé Pine configuration
set -g @rose_pine_variant 'main' # Use 'moon' for a soft, elegant aesthetic
set -g @rose_pine_directory '' # Show current directory
set -g @rose_pine_user '' # Show username
set -g @rose_pine_bar_bg_disable '' # Transparent background
set -g @rose_pine_bar_bg_disabled_color_option 'default' # Use terminal's default background
set -g @rose_pine_only_windows 'off' # Include more modules for a fancier look
set -g @rose_pine_disable_active_window_menu 'on' # Keep status bar clean
set -g @rose_pine_show_current_program 'on' # Show current program in window name
set -g @rose_pine_left_separator '  ' # Separator for left status
set -g @rose_pine_right_separator '  ' # Separator for right status
set -g @rose_pine_field_separator ' ┃ ' # Separator for fields
set -g @rose_pine_window_separator ' ─ ' # Separator between window number and name
set -g @rose_pine_session_icon '' # Custom session icon (terminal icon)
set -g @rose_pine_current_window_icon '' # Current window icon
set -g @rose_pine_folder_icon '' # Folder icon for directory

# Custom status bar sections with Rosé Pine colors
set -g @rose_pine_status_left_prepend_section '#{tmux_mode_indicator} #[fg=#3e8fb0]#[fg=#232136,bg=#3e8fb0]#{?client_prefix,Prefix,Normal}#[fg=#3e8fb0,bg=default]'
set -g @rose_pine_status_right_append_section '#[fg=#ea9a97]#[fg=#232136,bg=#ea9a97]#{user}#[fg=#ea9a97,bg=default] #[fg=#9ccfd8]#[fg=#232136,bg=#9ccfd8]%Y-%m-%d %H:%M#[fg=#9ccfd8,bg=default]'

# Status bar styling
set -g status-position top
set -g status-justify centre # Center window list for a balanced look
set -g status-style 'bg=#232136 fg=#e0def4' # Base background, Text foreground

# Custom window naming with more detail
set -g automatic-rename-format '#{?pane_current_command,#{pane_current_command}:,}#(basename #{pane_current_path})'

# Window styling with rounded corner effect
set -g window-status-format '#[fg=#393552]#[fg=#e0def4,bg=#393552]#I#{?window_zoomed_flag, 🔍,} #[fg=#e0def4,bg=#393552]#{window_name}#[fg=#393552,bg=default]'
set -g window-status-current-format '#[fg=#3e8fb0]#[fg=#232136,bg=#3e8fb0]#I#{?window_zoomed_flag, 🔍,} #[fg=#232136,bg=#3e8fb0]#{window_name}#[fg=#3e8fb0,bg=default]'

# Pane border styling
set -g pane-border-style 'fg=#393552' # Overlay for inactive borders
set -g pane-active-border-style 'fg=#3e8fb0' # Pine for active borders

# Message styling
set -g message-style 'fg=#e0def4 bg=#eb6f92' # Text foreground, Love background

# Initialize TPM (must be at the bottom)
run '~/.config/tmux/plugins/tpm/tpm'
