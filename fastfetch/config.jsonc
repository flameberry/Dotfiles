// Inspired by MoonVeil
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "padding": {
      "left": 0,
      "top": 1,
      "bottom": 1,
    },
    "width": 32,
    "source": "/Users/flameberry/.config/fastfetch/giorno.png",
    "type": "kitty",
  },
  "display": {
    "separator": " ",
  },
  "modules": [
    {
      "key": "╭───────────╮",
      "type": "custom",
    },
    {
      "key": "│ {#31} user    {#keys}│",
      "type": "title",
      "format": "{user-name}",
    },
    {
      "key": "│ {#33}󰅐 uptime  {#keys}│",
      "type": "uptime",
    },
    {
      "key": "│ {#34}{icon} distro  {#keys}│",
      "type": "os",
    },
    {
      "key": "│ {#35} kernel  {#keys}│",
      "type": "kernel",
    },
    {
      "key": "│ {#36} wm      {#keys}│",
      "type": "wm",
    },
    {
      "key": "│ {#36}󰇄 desktop {#keys}│",
      "type": "de",
    },
    {
      "key": "│ {#33}󰍛 cpu     {#keys}│",
      "type": "cpu",
      "showPeCoreCount": true,
    },
    {
      "key": "│ {#37}󰊄 gpu     {#keys}│",
      "type": "gpu",
    },
    {
      "key": "│ {#38}󰃮 battery {#keys}│",
      "type": "battery",
    },
    {
      "key": "│ {#39}󰍹 display {#keys}│",
      "type": "display",
    },
    {
      "key": "│ {#33}󰃵 audio   {#keys}│",
      "type": "audio",
    },
    {
      "key": "│ {#34}\udb80\udcaf BT      {#keys}│",
      "type": "bluetooth",
    },
    {
      "key": "│ {#31} term    {#keys}│",
      "type": "terminal",
    },
    {
      "key": "│ {#32} shell   {#keys}│",
      "type": "shell",
    },
    {
      "key": "│ {#38}󰈔 font    {#keys}│",
      "type": "terminal-font",
    },
    {
      "key": "│ {#39}󰔟 load    {#keys}│",
      "type": "load",
    },
    {
      "key": "├───────────┤",
      "type": "custom",
    },
    {
      "key": "│ {#39} colors  {#keys}│",
      "type": "colors",
      "symbol": "circle",
    },
    {
      "key": "╰───────────╯",
      "type": "custom",
    },
  ],
}
