# Make the prompt as close as possible to robbyrussell theme
format = "[➜](bold green) [$directory](green)[$git_branch](bright-blue)$character "
right_format = "$cmd_duration"
continuation_prompt = "[▸▹ ](dimmed white)"

add_newline = false

[cmd_duration]
min_time = 500
format = "[ took: $duration ](italic white)"
disabled = false

# Directory configuration
[directory]
truncation_length = 0
style = "green"

# Git branch config
[git_branch]
format = 'git:\([$branch](red)\) '
disabled = false

[git_metrics]
format = ' ([▴$added]($added_style))([▿$deleted]($deleted_style)) '
added_style = 'italic green'
deleted_style = 'italic red'
ignore_submodules = true
disabled = false

# Replace the '❯' symbol in the prompt with ''
[character] # The name of the module we are configuring is 'character'
success_symbol = '[](bold yellow)'
error_symbol = '[](bold red)' 

